{
  "name": "dsh-context-archive",
  "version": "0.9.10",
  "description": "Model-driven tool-result archiving for DeepSeek Harness: long results carry an inline id, the model archives the ones it no longer needs into the session's own folder, and a recoverable stub stays in context.",
  "type": "module",
  "main": "./lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingofpowers/dsh-context-archive.git"
  },
  "homepage": "https://github.com/kingofpowers/dsh-context-archive#readme",
  "bugs": {
    "url": "https://github.com/kingofpowers/dsh-context-archive/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "context",
    "tool-result",
    "archive",
    "compaction"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "dsh": "0.2.1-rc.1 || 0.2.1-rc.2",
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/core.js && node --check lib/index.js"
  },
  "license": "MIT"
}
